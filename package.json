{
  "name": "hillcash",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.18.3"
  },
  "scripts": {
    "dev": "npm run dev -w @hillcash/web",
    "build": "npm run build -w @hillcash/web",
    "lint": "npm run lint -w @hillcash/web",
    "test": "npm run test -w @hillcash/agent && npm run test -w @hillcash/provider && npm run test -w @hillcash/audit && npm run test -w @hillcash/contracts",
    "contracts:compile": "npm run compile -w @hillcash/contracts",
    "oracle:check": "npm run oracle:check -w @hillcash/contracts",
    "provider:issue": "npm run issue -w @hillcash/provider --",
    "provider:serve": "npm run serve -w @hillcash/provider",
    "audit:topic": "npm run topic -w @hillcash/audit",
    "audit:anchor": "npm run anchor -w @hillcash/audit --",
    "start": "npm run start -w @hillcash/web --",
    "agent:plan": "npm run plan -w @hillcash/agent --",
    "provider:terms": "npm run sign:terms -w @hillcash/provider --",
    "format": "prettier --write . --log-level warn",
    "demo:testnet": "node scripts/purchase-demo.mjs"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6",
    "ws@>=8 <9": "8.21.0",
    "postcss@>=8 <9": "8.5.28",
    "protobufjs@>=8 <9": "8.8.0"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
